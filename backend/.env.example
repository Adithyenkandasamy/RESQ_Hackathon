# ============================================================
# Emergency Response Coordination System — Environment Config
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.
# ============================================================

# --- Application ---
APP_NAME="Emergency Response Coordination System"
APP_ENV=development          # development | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX=/api/v1

# --- Database (Aiven PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname?ssl=require
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed origins.
# Development example: http://localhost:3000,http://localhost:8081
# Production: https://your-hospital-dashboard.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Cache ---
CACHE_DEFAULT_TTL=300        # seconds
CACHE_MAX_ENTRIES=1000
